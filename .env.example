# --- Application -------------------------------------------------------------
APP_NAME=nquire
DOMAIN=nquire.ai
ENVIRONMENT=development

# --- Ports -------------------------------------------------------------------
FRONTEND_PORT=3000
GO_PORT=8002
PYTHON_PORT=8001

# --- Database (PostgreSQL) ----------------------------------------------------
# In Docker use the service name: postgres
# Locally use: localhost
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=ttsql
DATABASE_USER=ttsql
DATABASE_PASSWORD=

# --- Cache (Redis) ------------------------------------------------------------
# In Docker use the service name: redis
# Locally use: localhost
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=
# Google OAuth Client ID (used by both Go backend and Vite frontend)
GOOGLE_CLIENT_ID=

# --- LLM Provider -------------------------------------------------------------
LLM_PROVIDER=bedrock
LLM_MODEL=

BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=us-east-1

OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- LangSmith Tracing --------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
GIN_MODE=release

# --- Internal Service URLs (overridden by docker-compose in containers) -------
# Local dev: http://localhost:8001
# Docker:    http://agent:8001  (set automatically by compose)
PYTHON_API_URL=http://localhost:8001

# --- Backend Data Directory ---------------------------------------------------
# Local dev: leave empty (auto-detected)
# Docker:    /data  (mounted volume, set automatically by compose)
BACKEND_DATA_DIR=

# --- Root Database Directory --------------------------------------------------
# Local dev: leave empty (auto-detected to project_root/database)
# Docker:    /database (mounted volume, set automatically by compose)
DATABASE_DIR=

# --- Storage ------------------------------------------------------------------
STORAGE_PROVIDER=local

# --- Frontend (Vite) ---------------------------------------------------------
# Copy these into apps/web/.env (Vite only reads its own .env file)
# VITE_ prefix is required -- any other prefix is invisible to the browser bundle.
#
# Google OAuth Client ID from console.cloud.google.com
#   APIs & Services -> Credentials -> OAuth 2.0 Client IDs
#   Application type: Web application
#   Authorized JavaScript origins:
#     http://localhost:3000          (local dev)
#     https://nquire.ai              (production)
#   Authorized redirect URIs:
#     http://localhost:3000
#     https://nquire.ai
VITE_GOOGLE_CLIENT_ID=

# Base URL for API calls from the browser.
# Leave as /api in all environments -- Vite dev-proxy and Nginx both rewrite it.
VITE_API_BASE_URL=/api
DEFAULT_USERNAME="anonymous"
